unsafe {
#include <stdio.h>
}

struct sData
{
    int a;
    int b;
    int c;
};

int main(void)
{
    int data[3];
    Span<int> values;
    Span<int> values2;
    
    sData data2;

    data[0] = 10;
    data[1] = 20;
    data[2] = 30;

    values = Span<int>.from(data, 3);
    
    printf("%d\n", *values);
    values++;
    printf("%d\n", *values);
    
    data2 = new sData {
        a:10, b:20, c:30
    };
    
    values2 = Span<int>.from_bytes(&data2, sizeof(sData));
    
    printf("%d\n", *values2);
    values2++;
    printf("%d\n", *values2);
    
    return 0;
}
