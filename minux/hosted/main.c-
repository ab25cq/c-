unsafe {
#include <stdio.h>
}

#define MINUX_PAGE_WORDS 64
#define MINUX_RAM_WORDS 4096
#define MINUX_VPAGES 64
#define MINUX_REGS 16
#define MINUX_MAX_CODE 128
#define MINUX_MAX_PROC 8
#define MINUX_MAX_FILES 4
#define MINUX_FILE_WORDS 64

#define OP_NOP 0
#define OP_MOVI 1
#define OP_ADD 2
#define OP_STORE 3
#define OP_LOAD 4
#define OP_SYSCALL 5
#define OP_HALT 6
#define OP_JNZ 7
#define OP_SUB 8

#define SYS_PUTCHAR 1
#define SYS_EXIT 2
#define SYS_YIELD 3
#define SYS_WRITE 4
#define SYS_GETPID 5
#define SYS_OPEN 6
#define SYS_READ 7

#define PROC_EMPTY 0
#define PROC_RUNNABLE 1
#define PROC_ZOMBIE 2

#define TRAP_NONE 0
#define TRAP_SYSCALL 1
#define TRAP_PAGE_FAULT 2
#define TRAP_ILLEGAL_INSN 3
#define TRAP_TIMER_IRQ 4

#define FD_STDOUT 1
#define KERNEL_MSG_ADDR 200
#define SECOND_MSG_ADDR 220
#define PATH_DEV_NULL_ADDR 240
#define PATH_ETC_MOTD_ADDR 260
#define FILE_READ_ADDR 300
#define TIMER_RELOAD 100
#define ENTRY_INIT 0
#define ENTRY_WORKER 40

struct Machine {
    int ram[MINUX_RAM_WORDS];
    int page_table[MINUX_VPAGES];
    int regs[MINUX_REGS];
    int insn_opcode[MINUX_MAX_CODE];
    int a[MINUX_MAX_CODE];
    int b[MINUX_MAX_CODE];
    int c[MINUX_MAX_CODE];
    int proc_pid_storage[MINUX_MAX_PROC];
    int proc_state_storage[MINUX_MAX_PROC];
    int proc_entry_storage[MINUX_MAX_PROC];
    int proc_pc_storage[MINUX_MAX_PROC];
    int proc_r0_storage[MINUX_MAX_PROC];
    int proc_r1_storage[MINUX_MAX_PROC];
    int proc_r2_storage[MINUX_MAX_PROC];
    int file_name_storage[MINUX_MAX_FILES];
    int file_data_base_storage[MINUX_MAX_FILES];
    int file_len_storage[MINUX_MAX_FILES];
    int pc;
    int running;
    int current_pid;
    int current_proc;
    int mode;
    int last_trap;
    int trap_pc;
    int ticks;
    int timer_counter;
    int timer_reload;
    int irq_pending;
};

void minux_raise(mut ref Machine m, int trap)
{
    m.last_trap = trap;
    m.trap_pc = m.pc;
    if (trap == TRAP_PAGE_FAULT || trap == TRAP_ILLEGAL_INSN) {
        m.running = 0;
    }
}

void minux_map_page(Span<int> page_table, int virt_page, int phys_page)
{
    if (virt_page < 0 || virt_page >= page_table.len()) {
        cminus_panic("mmu virtual page out of range", __FILE__, __LINE__);
    }
    if (phys_page < 0 || phys_page >= page_table.len()) {
        cminus_panic("mmu physical page out of range", __FILE__, __LINE__);
    }
    page_table.set(virt_page, phys_page);
}

int minux_translate(Span<int> page_table, int virtual_word, int ram_len)
{
    int virt_page;
    int offset;
    int phys_page;
    int phys_word;

    if (virtual_word < 0) {
        cminus_panic("mmu negative virtual address", __FILE__, __LINE__);
    }
    virt_page = virtual_word / MINUX_PAGE_WORDS;
    offset = virtual_word - virt_page * MINUX_PAGE_WORDS;
    if (virt_page < 0 || virt_page >= page_table.len()) {
        cminus_panic("mmu page fault", __FILE__, __LINE__);
    }
    phys_page = page_table.get(virt_page);
    if (phys_page < 0) {
        cminus_panic("mmu unmapped page", __FILE__, __LINE__);
    }
    phys_word = phys_page * MINUX_PAGE_WORDS + offset;
    if (phys_word < 0 || phys_word >= ram_len) {
        cminus_panic("mmu physical address out of range", __FILE__, __LINE__);
    }
    return phys_word;
}

int minux_load_word(mut ref Machine m, int virtual_word)
{
    Span<int> ram = Span<int>.from(m.ram, MINUX_RAM_WORDS);
    Span<int> page_table = Span<int>.from(m.page_table, MINUX_VPAGES);
    int phys = minux_translate(page_table, virtual_word, ram.len());

    return ram.get(phys);
}

void minux_store_word(mut ref Machine m, int virtual_word, int value)
{
    Span<int> ram = Span<int>.from(m.ram, MINUX_RAM_WORDS);
    Span<int> page_table = Span<int>.from(m.page_table, MINUX_VPAGES);
    int phys = minux_translate(page_table, virtual_word, ram.len());

    ram.set(phys, value);
}

void minux_store_cstr(mut ref Machine m, int addr, int c0, int c1, int c2, int c3, int c4, int c5, int c6, int c7)
{
    minux_store_word(m, addr + 0, c0);
    minux_store_word(m, addr + 1, c1);
    minux_store_word(m, addr + 2, c2);
    minux_store_word(m, addr + 3, c3);
    minux_store_word(m, addr + 4, c4);
    minux_store_word(m, addr + 5, c5);
    minux_store_word(m, addr + 6, c6);
    minux_store_word(m, addr + 7, c7);
}

int minux_cstr_eq(mut ref Machine m, int addr, int c0, int c1, int c2, int c3, int c4, int c5, int c6, int c7)
{
    return minux_load_word(m, addr + 0) == c0 &&
        minux_load_word(m, addr + 1) == c1 &&
        minux_load_word(m, addr + 2) == c2 &&
        minux_load_word(m, addr + 3) == c3 &&
        minux_load_word(m, addr + 4) == c4 &&
        minux_load_word(m, addr + 5) == c5 &&
        minux_load_word(m, addr + 6) == c6 &&
        minux_load_word(m, addr + 7) == c7;
}

void minux_clear_machine(mut ref Machine m)
{
    Span<int> ram = Span<int>.from(m.ram, MINUX_RAM_WORDS);
    Span<int> page_table = Span<int>.from(m.page_table, MINUX_VPAGES);
    Span<int> regs = Span<int>.from(m.regs, MINUX_REGS);
    Span<int> proc_pids = Span<int>.from(m.proc_pid_storage, MINUX_MAX_PROC);
    Span<int> proc_states = Span<int>.from(m.proc_state_storage, MINUX_MAX_PROC);
    Span<int> proc_entries = Span<int>.from(m.proc_entry_storage, MINUX_MAX_PROC);
    Span<int> proc_pcs = Span<int>.from(m.proc_pc_storage, MINUX_MAX_PROC);
    Span<int> proc_r0 = Span<int>.from(m.proc_r0_storage, MINUX_MAX_PROC);
    Span<int> proc_r1 = Span<int>.from(m.proc_r1_storage, MINUX_MAX_PROC);
    Span<int> proc_r2 = Span<int>.from(m.proc_r2_storage, MINUX_MAX_PROC);
    Span<int> file_names = Span<int>.from(m.file_name_storage, MINUX_MAX_FILES);
    Span<int> file_bases = Span<int>.from(m.file_data_base_storage, MINUX_MAX_FILES);
    Span<int> file_lens = Span<int>.from(m.file_len_storage, MINUX_MAX_FILES);
    int i;

    i = 0;
    while (i < ram.len()) {
        ram.set(i, 0);
        i++;
    }
    i = 0;
    while (i < page_table.len()) {
        page_table.set(i, -1);
        i++;
    }
    i = 0;
    while (i < regs.len()) {
        regs.set(i, 0);
        i++;
    }
    i = 0;
    while (i < proc_pids.len()) {
        proc_pids.set(i, 0);
        proc_states.set(i, PROC_EMPTY);
        proc_entries.set(i, 0);
        proc_pcs.set(i, 0);
        proc_r0.set(i, 0);
        proc_r1.set(i, 0);
        proc_r2.set(i, 0);
        i++;
    }
    i = 0;
    while (i < file_names.len()) {
        file_names.set(i, 0);
        file_bases.set(i, 0);
        file_lens.set(i, 0);
        i++;
    }
    m.pc = 0;
    m.running = 1;
    m.current_pid = 1;
    m.current_proc = 0;
    m.mode = 0;
    m.last_trap = TRAP_NONE;
    m.trap_pc = 0;
    m.ticks = 0;
    m.timer_counter = 0;
    m.timer_reload = TIMER_RELOAD;
    m.irq_pending = 0;
}

void minux_init_mmu(mut ref Machine m)
{
    Span<int> page_table = Span<int>.from(m.page_table, MINUX_VPAGES);
    int i = 0;

    while (i < 16) {
        minux_map_page(page_table, i, i);
        i++;
    }
}

void minux_spawn_init(mut ref Machine m)
{
    Span<int> proc_pids = Span<int>.from(m.proc_pid_storage, MINUX_MAX_PROC);
    Span<int> proc_states = Span<int>.from(m.proc_state_storage, MINUX_MAX_PROC);
    Span<int> proc_entries = Span<int>.from(m.proc_entry_storage, MINUX_MAX_PROC);
    Span<int> proc_pcs = Span<int>.from(m.proc_pc_storage, MINUX_MAX_PROC);
    int init_pid = 1;
    int init_entry = ENTRY_INIT;
    int worker_pid = 2;
    int worker_entry = ENTRY_WORKER;

    proc_pids.set(0, init_pid);
    proc_states.set(0, PROC_RUNNABLE);
    proc_entries.set(0, init_entry);
    proc_pcs.set(0, init_entry);
    proc_pids.set(1, worker_pid);
    proc_states.set(1, PROC_RUNNABLE);
    proc_entries.set(1, worker_entry);
    proc_pcs.set(1, worker_entry);
    m.current_pid = init_pid;
    m.current_proc = 0;
    m.pc = init_entry;
}

void minux_save_current(mut ref Machine m)
{
    Span<int> regs = Span<int>.from(m.regs, MINUX_REGS);
    Span<int> proc_pcs = Span<int>.from(m.proc_pc_storage, MINUX_MAX_PROC);
    Span<int> proc_r0 = Span<int>.from(m.proc_r0_storage, MINUX_MAX_PROC);
    Span<int> proc_r1 = Span<int>.from(m.proc_r1_storage, MINUX_MAX_PROC);
    Span<int> proc_r2 = Span<int>.from(m.proc_r2_storage, MINUX_MAX_PROC);
    int index = m.current_proc;
    int r0;
    int r1;
    int r2;

    r0 = regs.get(0);
    r1 = regs.get(1);
    r2 = regs.get(2);
    proc_pcs.set(index, m.pc);
    proc_r0.set(index, r0);
    proc_r1.set(index, r1);
    proc_r2.set(index, r2);
}

void minux_load_current(mut ref Machine m, int index)
{
    Span<int> regs = Span<int>.from(m.regs, MINUX_REGS);
    Span<int> proc_pids = Span<int>.from(m.proc_pid_storage, MINUX_MAX_PROC);
    Span<int> proc_pcs = Span<int>.from(m.proc_pc_storage, MINUX_MAX_PROC);
    Span<int> proc_r0 = Span<int>.from(m.proc_r0_storage, MINUX_MAX_PROC);
    Span<int> proc_r1 = Span<int>.from(m.proc_r1_storage, MINUX_MAX_PROC);
    Span<int> proc_r2 = Span<int>.from(m.proc_r2_storage, MINUX_MAX_PROC);
    int r0;
    int r1;
    int r2;

    m.current_proc = index;
    m.current_pid = proc_pids.get(index);
    m.pc = proc_pcs.get(index);
    r0 = proc_r0.get(index);
    r1 = proc_r1.get(index);
    r2 = proc_r2.get(index);
    regs.set(0, r0);
    regs.set(1, r1);
    regs.set(2, r2);
}

int minux_find_next_runnable(mut ref Machine m)
{
    Span<int> proc_states = Span<int>.from(m.proc_state_storage, MINUX_MAX_PROC);
    int i = 1;
    int index;

    while (i <= proc_states.len()) {
        index = m.current_proc + i;
        if (index >= proc_states.len()) {
            index = index - proc_states.len();
        }
        if (proc_states.get(index) == PROC_RUNNABLE) {
            return index;
        }
        i++;
    }
    return -1;
}

void minux_schedule(mut ref Machine m)
{
    int next;

    minux_save_current(m);
    next = minux_find_next_runnable(m);
    if (next < 0) {
        m.running = 0;
        return;
    }
    minux_load_current(m, next);
}

void minux_exit_current(mut ref Machine m)
{
    Span<int> proc_states = Span<int>.from(m.proc_state_storage, MINUX_MAX_PROC);

    proc_states.set(m.current_proc, PROC_ZOMBIE);
    minux_schedule(m);
}

void minux_emit(mut ref Machine m, int pc, int opcode, int a, int b, int c)
{
    Span<int> code_ops = Span<int>.from(m.insn_opcode, MINUX_MAX_CODE);
    Span<int> code_a = Span<int>.from(m.a, MINUX_MAX_CODE);
    Span<int> code_b = Span<int>.from(m.b, MINUX_MAX_CODE);
    Span<int> code_c = Span<int>.from(m.c, MINUX_MAX_CODE);

    code_ops.set(pc, opcode);
    code_a.set(pc, a);
    code_b.set(pc, b);
    code_c.set(pc, c);
}

void minux_load_kernel(mut ref Machine m)
{
    int pc = 0;

    minux_store_cstr(m, PATH_ETC_MOTD_ADDR, '/', 'm', 'o', 't', 'd', 0, 0, 0);
    minux_store_cstr(m, FILE_READ_ADDR, 'o', 's', '\n', 0, 0, 0, 0, 0);
    minux_emit(m, pc, OP_MOVI, 1, KERNEL_MSG_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'm', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'i', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 1); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'n', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 2); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'u', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 3); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'x', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 4); pc++;
    minux_emit(m, pc, OP_MOVI, 2, '\n', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 5); pc++;
    minux_emit(m, pc, OP_MOVI, 0, FD_STDOUT, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 1, KERNEL_MSG_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 6, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_WRITE, 0, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_YIELD, 0, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 0, PATH_ETC_MOTD_ADDR, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_OPEN, 0, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 1, FILE_READ_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 3, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_READ, 0, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 0, FD_STDOUT, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 1, FILE_READ_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 3, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_WRITE, 0, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_EXIT, 0, 0); pc++;
    minux_emit(m, pc, OP_HALT, 0, 0, 0);

    pc = ENTRY_WORKER;
    minux_emit(m, pc, OP_MOVI, 1, SECOND_MSG_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 'p', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, '2', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 1); pc++;
    minux_emit(m, pc, OP_MOVI, 2, '\n', 0); pc++;
    minux_emit(m, pc, OP_STORE, 2, 1, 2); pc++;
    minux_emit(m, pc, OP_MOVI, 0, FD_STDOUT, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 1, SECOND_MSG_ADDR, 0); pc++;
    minux_emit(m, pc, OP_MOVI, 2, 3, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_WRITE, 0, 0); pc++;
    minux_emit(m, pc, OP_SYSCALL, SYS_EXIT, 0, 0); pc++;
}

void minux_init_vfs(mut ref Machine m)
{
    Span<int> file_names = Span<int>.from(m.file_name_storage, MINUX_MAX_FILES);
    Span<int> file_bases = Span<int>.from(m.file_data_base_storage, MINUX_MAX_FILES);
    Span<int> file_lens = Span<int>.from(m.file_len_storage, MINUX_MAX_FILES);

    file_names.set(0, PATH_ETC_MOTD_ADDR);
    file_bases.set(0, FILE_READ_ADDR);
    file_lens.set(0, 3);
}

int minux_open_path(mut ref Machine m, int path_addr)
{
    if (minux_cstr_eq(m, path_addr, '/', 'm', 'o', 't', 'd', 0, 0, 0)) {
        return 3;
    }
    return -1;
}

int minux_read_fd(mut ref Machine m, int fd, int addr, int len)
{
    int i = 0;
    int ch;

    if (fd != 3) {
        return -1;
    }
    while (i < len && i < 3) {
        ch = minux_load_word(m, FILE_READ_ADDR + i);
        minux_store_word(m, addr + i, ch);
        i++;
    }
    return i;
}

void minux_write_fd(mut ref Machine m, int fd, int addr, int len)
{
    int i = 0;
    int ch;

    if (fd != FD_STDOUT) {
        cminus_panic("bad file descriptor", __FILE__, __LINE__);
    }
    while (i < len) {
        ch = minux_load_word(m, addr + i);
        unsafe {
            putchar(ch);
        }
        i++;
    }
}

void minux_syscall(mut ref Machine m, int number)
{
    Span<int> regs = Span<int>.from(m.regs, MINUX_REGS);
    int fd;
    int addr;
    int len;

    minux_raise(m, TRAP_SYSCALL);
    if (number == SYS_PUTCHAR) {
        unsafe {
            putchar(regs.get(0));
        }
    } else if (number == SYS_EXIT) {
        minux_exit_current(m);
    } else if (number == SYS_YIELD) {
        minux_schedule(m);
        return;
    } else if (number == SYS_WRITE) {
        fd = regs.get(0);
        addr = regs.get(1);
        len = regs.get(2);
        minux_write_fd(m, fd, addr, len);
    } else if (number == SYS_GETPID) {
        regs.set(0, m.current_pid);
    } else if (number == SYS_OPEN) {
        addr = regs.get(0);
        regs.set(0, minux_open_path(m, addr));
    } else if (number == SYS_READ) {
        fd = regs.get(0);
        addr = regs.get(1);
        len = regs.get(2);
        regs.set(0, minux_read_fd(m, fd, addr, len));
    } else {
        cminus_panic("unknown syscall", __FILE__, __LINE__);
    }
}

void minux_timer_tick(mut ref Machine m)
{
    m.timer_counter++;
    if (m.timer_reload > 0 && m.timer_counter >= m.timer_reload) {
        m.timer_counter = 0;
        m.irq_pending = 1;
    }
}

void minux_handle_interrupts(mut ref Machine m)
{
    if (!m.irq_pending) {
        return;
    }
    m.irq_pending = 0;
    m.ticks++;
    minux_raise(m, TRAP_TIMER_IRQ);
    minux_schedule(m);
}

void minux_step(mut ref Machine m)
{
    Span<int> regs = Span<int>.from(m.regs, MINUX_REGS);
    Span<int> code_ops = Span<int>.from(m.insn_opcode, MINUX_MAX_CODE);
    Span<int> code_a = Span<int>.from(m.a, MINUX_MAX_CODE);
    Span<int> code_b = Span<int>.from(m.b, MINUX_MAX_CODE);
    Span<int> code_c = Span<int>.from(m.c, MINUX_MAX_CODE);
    int opcode = code_ops.get(m.pc);
    int a = code_a.get(m.pc);
    int b = code_b.get(m.pc);
    int c = code_c.get(m.pc);
    int left;
    int right;
    int value;

    minux_handle_interrupts(m);
    m.pc++;
    if (opcode == OP_NOP) {
        return;
    } else if (opcode == OP_MOVI) {
        regs.set(a, b);
    } else if (opcode == OP_ADD) {
        left = regs.get(b);
        right = regs.get(c);
        regs.set(a, left + right);
    } else if (opcode == OP_SUB) {
        left = regs.get(b);
        right = regs.get(c);
        regs.set(a, left - right);
    } else if (opcode == OP_STORE) {
        left = regs.get(b);
        value = regs.get(a);
        minux_store_word(m, left + c, value);
    } else if (opcode == OP_LOAD) {
        left = regs.get(b);
        value = minux_load_word(m, left + c);
        regs.set(a, value);
    } else if (opcode == OP_SYSCALL) {
        minux_syscall(m, a);
    } else if (opcode == OP_HALT) {
        m.running = 0;
    } else if (opcode == OP_JNZ) {
        if (regs.get(a) != 0) {
            m.pc = b;
        }
    } else {
        minux_raise(m, TRAP_ILLEGAL_INSN);
        cminus_panic("illegal instruction", __FILE__, __LINE__);
    }
    minux_timer_tick(m);
}

void minux_boot(mut ref Machine m)
{
    int budget = 10000;

    minux_clear_machine(m);
    minux_init_mmu(m);
    minux_spawn_init(m);
    minux_load_kernel(m);
    minux_init_vfs(m);
    while (m.running && budget > 0) {
        minux_step(m);
        budget--;
    }
    if (budget == 0) {
        cminus_panic("emulator watchdog timeout", __FILE__, __LINE__);
    }
}

int main(void)
{
    Machine machine;

    minux_boot(&machine);
    return 0;
}
