Atomic<int> detached_done;

int detached_worker(void)
{
    int i = 0;

    while (i < 1000) {
        Thread.yield();
        i++;
    }
    detached_done.store(1);
    return 0;
}

int main(void)
{
    Thread worker;

    detached_done.store(0);
    worker = Thread.spawn(detached_worker);
    worker.detach();
    while (detached_done.load() == 0) {
        Thread.yield();
    }
    return 0;
}
