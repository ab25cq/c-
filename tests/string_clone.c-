#define _GNU_SOURCE
unsafe {
#include <stdio.h>
#include <string.h>
}

struct Person {
    string name;
    int age;
};

int main(void)
{
    string source = s"Alice";
    Person person = new Person;

    person->name = clone source;
    person->age = 42;
    Person copy = clone person;

    if (person->name == NULL || copy == NULL || copy->name == NULL) {
        return 1;
    }
    if (copy->name == person->name) {
        return 2;
    }
    if (!copy.name.eq("Alice") || copy->age != 42) {
        return 3;
    }
    return 0;
}
