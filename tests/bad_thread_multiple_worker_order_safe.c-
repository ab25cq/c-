struct LeftWork {
    int value;
};

struct RightWork {
    int value;
};

int consume_pair(owned Box<RightWork> right,
                 owned Box<LeftWork> left)
{
    return left.value + right.value;
}

int main(void)
{
    Box<LeftWork> left = new LeftWork;
    Box<RightWork> right = new RightWork;
    Thread thread;

    thread = Thread.spawn(move left, move right, consume_pair);
    return thread.join();
}
