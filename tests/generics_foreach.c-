unsafe {
#include <stdlib.h>
}

struct Item {
    int value;
};

int main(void)
{
    int sum = 0;
    int item_sum = 0;
    int list_sum = 0;
    Vec<int> nums = Vec<int>.new();
    Vec<int> dyn = Vec<int>.new();
    Vec<Item> item_vec = Vec<Item>.new();
    List<int> list = List<int>.new();
    Map<int,int> map = Map<int,int>.new();

    nums.push(1);
    nums.push(2);
    nums.push(3);
    item_vec.push(new Item { value: 4 });
    item_vec.push(new Item { value: 5 });
    foreach (int value in nums) {
        sum += value;
    }
    foreach (Item item in item_vec) {
        item_sum += item->value;
    }
    list.push(6);
    list.push(7);
    foreach (int value in list) {
        list_sum += value;
    }
    if (nums.first() != 1) {
        return 1;
    }
    if (nums[1] != 2) {
        return 1;
    }
    if (nums.len() != 3 || nums.is_empty()) {
        return 1;
    }
    dyn.reserve(2);
    dyn.push(8);
    dyn.push(9);
    if (dyn.len() != 2 || dyn.capacity() < 2 || dyn.last() != 9) {
        return 1;
    }
    if (!dyn.set(0, 10) || dyn.get(0) != 10) {
        return 1;
    }
    struct __CMinusIndex<int> popped_vec = dyn.pop_opt();
    if (!popped_vec.is_Some() || popped_vec.get_Some() != 9 || dyn.len() != 1) {
        return 1;
    }
    dyn.clear();
    if (!dyn.is_empty()) {
        return 1;
    }
    if (list.first() != 6) {
        return 1;
    }
    if (list[1] != 7) {
        return 1;
    }
    map.set(100, 200);
    map.set(101, 201);
    struct __CMinusIndex<int> map_value = map.get_opt(100);
    if (!map_value.is_Some() || map_value.get_Some() != 200 || !map.contains(101)) {
        return 1;
    }
    map.remove(100);
    if (map.contains(100) || map.len() != 1) {
        return 1;
    }
    list.push_front(5);
    if (list.len() != 3 || list.first() != 5 || list.last() != 7) {
        return 1;
    }
    if (!list.set(1, 66) || list.get(1) != 66) {
        return 1;
    }
    struct __CMinusIndex<int> front = list.pop_front_opt();
    if (!front.is_Some() || front.get_Some() != 5 || list.len() != 2) {
        return 1;
    }
    list.clear();
    if (!list.is_empty()) {
        return 1;
    }
    return sum == 6 && item_sum == 9 && list_sum == 13 ? 0 : 1;
}
