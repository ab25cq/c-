#define _GNU_SOURCE
unsafe {
#include <stdio.h>
#include <string.h>
}

int main(void)
{
    int count = 0;

    if (s"if".eq("if")) {
        count++;
    } else if (s"else".eq("else")) {
        count = 100;
    }

    while (count < 2 && s"while".eq("while")) {
        count++;
    }

    do {
        count++;
    } while (count < 4 && s"do".eq("do"));

    return count == 4 ? 0 : 1;
}
