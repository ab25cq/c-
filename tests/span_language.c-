    Span<int> name = Span<int>.from(name_data, 4);
    Span<int> src_name = Span<int>.from(src_name_data, 4);
    Span<int> empty = Span<int>.empty();
    struct __CMinusIndex<int> third;
    int sum = 0;

    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    third = values.get_opt(2);

    if (values.len() != 3 || values.is_empty()) {
        return 1;
    }
    if (bytes.len() != 3 || bytes[2] != 30) {
        return 6;
    }
    if (!empty.is_empty()) {
        return 2;
    }
    if (values[1] != 20) {
        return 3;
    }
    if (!third.is_Some() || third.get_Some() != 30) {
