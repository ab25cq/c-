unsafe {
#include <stdlib.h>
#include <string.h>

void* raw_alloc(size_t size) __attribute__((malloc));

void* raw_alloc(size_t size)
{
    return malloc(size);
}

int main(void)
{
    int* p = raw_alloc(sizeof(int));
    int* value = raw_alloc(sizeof(int));

    free(p);
    p = raw_alloc(sizeof(int));
    free(value);
    value = raw_alloc(sizeof(int));

    if (p == NULL || value == NULL) {
        return 1;
    }
    free(p);
    free(value);
    return 0;
}
}
