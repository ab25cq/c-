struct PairState {
    int value;
    int check;
};

Shared<struct PairState> shared_state;

int shared_worker(void)
{
    int i;

    for (i = 1; i <= 2000; i++) {
        SharedGuard<struct PairState> guard = shared_state.lock();
        PairState next = guard.load();

        next.value = next.value + 1;
        next.check = next.value ^ 0x55aa;
        guard.store(next);
    }
    return 0;
}

int main(void)
{
    PairState initial;
    PairState result;
    Thread first;
    Thread second;

    initial.value = 0;
    initial.check = 0x55aa;
    shared_state.store(initial);
    first = Thread.spawn(shared_worker);
    second = Thread.spawn(shared_worker);
    first.join();
    second.join();
    result = shared_state.load();
    if (result.check != (result.value ^ 0x55aa)) {
        return 1;
    }
    return result.value == 4000 ? 0 : 2;
}
