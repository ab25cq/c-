struct Child {
    int value;
};

struct Parent {
    Box<Child> child;
    int count;
};

int child_value(ref Child child)
{
    return child.value;
}

int main(void)
{
    Box<Parent> parent = new Parent;
    Box<Child> child = new Child;

    child.value = 11;
    parent.child = move child;
    parent.count = child_value(parent.child) + 1;

    if (parent.child.value != 11) {
        return 1;
    }
    if (parent.count != 12) {
        return 2;
    }
    return 0;
}
