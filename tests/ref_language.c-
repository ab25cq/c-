unsafe {
#include <stdio.h>
}

int main(void)
{
    int value = 10;
    Ref<int> reference = Ref<int>.from(&value);

    if (reference.is_null()) {
        return 1;
    }
    if (reference.get() != 10) {
        return 2;
    }
    reference.set(25);
    if (value != 25 || reference.get() != 25) {
        return 3;
    }
    printf("%d\n", reference.get());
    return 0;
}
