Atomic<int> total;
Mutex gate;
Atomic<int> guarded_total;

int worker(void)
{
    gate.lock();
    guarded_total.fetch_add(1);
    gate.unlock();
    total.fetch_add(1);
    Thread.yield();
    return 11;
}

int main(void)
{
    Thread t1;
    Thread t2;
    int r1;
    int r2;

    total.store(0);
    guarded_total.store(0);
    t1 = Thread.spawn(worker);
    t2 = Thread.spawn(worker);
    r1 = t1.join();
    r2 = t2.join();
    if (r1 != 11 || r2 != 11) {
        return 1;
    }
    if (total.load() != 2 || guarded_total.load() != 2) {
        return 2;
    }
    return 0;
}
