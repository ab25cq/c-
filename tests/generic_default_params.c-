#include <stdio.h>

generic<T>
T choose(T a, T b = 20, T c = 3)
{
    return a + b * c;
}

int main(void)
{
    int a = choose<int>(2);
    int b = choose<int>(2, 4);
    int c = choose<int>(2, 4, 5);
    int d = choose<int>(2, c: 5);
    int e = choose<int>(c: 7, a: 1);

    if (a != 62) {
        return 1;
    }
    if (b != 14) {
        return 2;
    }
    if (c != 22) {
        return 3;
    }
    if (d != 102) {
        return 4;
    }
    if (e != 141) {
        return 5;
    }
    printf("%d %d %d %d %d\n", a, b, c, d, e);
    return 0;
}
