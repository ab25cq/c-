unsafe {
#include <string.h>
}

struct Pair {
    string left;
    string right;
};

int main(void)
{
    Pair p = new Pair { left: s"7", right: s"9" };

    string left_copy = clone p->left;
    string right_copy = clone p->right;
    Pair q = clone p;

    if (left_copy == NULL || right_copy == NULL || q == NULL) {
        return 1;
    }
    if (!left_copy.eq("7") || !right_copy.eq("9")) {
        return 2;
    }
    if (q->left == NULL || q->right == NULL) {
        return 3;
    }
    if (q->left == p->left || q->right == p->right) {
        return 4;
    }
    if (!q.left.eq("7") || !q.right.eq("9")) {
        return 5;
    }
    return 0;
}
