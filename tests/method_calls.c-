unsafe {
#include <string.h>
}

struct data {
    int value;
};

void data_show(data self)
{
    self->value = 42;
}

int main(void)
{
    data d = new data;
    data p = new data;

    d.show();
    p.show();

    if (d->value != 42 || p->value != 42) {
        return 1;
    }
    if ("aaa".cmp("aaa") != 0) {
        return 2;
    }
    return "aaa".cmp("aaa");
}
