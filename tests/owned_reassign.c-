unsafe {
#include <stdlib.h>
}

int main(void)
{
    unsafe {
        int* owned_value = calloc(1, sizeof(int));
        int* value = calloc(1, sizeof(int));

        free(owned_value);
        owned_value = calloc(1, sizeof(int));
        free(value);
        value = calloc(1, sizeof(int));

        if (owned_value == NULL || value == NULL) {
            return 1;
        }
        free(owned_value);
        free(value);
    }
    return 0;
}
