#include <stdlib.h>

struct Pair {
    int x;
    int y;
};

unsafe {
union Cell {
    int i;
    char c;
};
}

enum Kind {
    KIND_A = 0,
    KIND_B = 1,
};

int main(void)
{
    Box<Pair> p = new Pair;
    enum Kind kind = KIND_A;
    p->x = kind;
    unsafe {
        union Cell cell;
        cell.i = 7;
        return cell.i - 7;
    }
}
