int main(void)
{
    unsigned int cell = 0;
    Register<unsigned int> reg;

    unsafe {
        reg = Register<unsigned int>.from_addr((unsigned long)&cell);
    }

    reg.write(0x10u);
    reg.set_bits(0x03u);
    reg.clear_bits(0x01u);
    reg.replace_bits(0x30u, 0x20u);
    return reg.read() == 0x22u && reg.get_bits(0x30u) == 0x20u && reg.has_bits(0x02u) ? 0 : 1;
}
