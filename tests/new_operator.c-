#include <stdlib.h>

struct Item {
    int value;
};

int main(void)
{
    Item item = new Item;

    unsafe {
        int* owned_value = calloc(1, sizeof(int));
        if (owned_value == NULL || item == NULL) {
            return 1;
        }
        *owned_value = 3;
        if (*owned_value != 3 || item->value != 0) {
            return 2;
        }
    }
    return 0;
}
