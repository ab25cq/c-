Optional<int> make_value(int value)
{
    return new Optional<int>.Some(value);
}

int main(void)
{
    int value = 3;
    Optional<int> maybe = make_value(9);
    Ref<int> reference = Ref<int>.from(&value);

    reference.set(reference.get() + maybe.get_Some());
    return value == 12 && maybe.is_Some() ? 0 : 1;
}
