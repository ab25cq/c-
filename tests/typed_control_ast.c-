int cminus_control_ast_probe(int limit)
{
    int total = 0;

    for (int i = 0; i < limit; i += 1) {
        total += i;
    }
    while (total < 6) {
        total += 1;
    }
    if (total == 6) {
        total += 2;
    } else {
        total = 0;
    }
    switch (total) {
    case 8:
        total += 1;
        break;
    default:
        break;
    }
    for (int ignored = 0; ignored < 1; ignored += 1) {
        continue;
    }
    do {
        total += 1;
    } while (total < 10);
    return total;
}

int main(void)
{
    return cminus_control_ast_probe(4) == 10 ? 0 : 1;
}
