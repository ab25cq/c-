unsafe {
#include <stdio.h>
}
#include <c-.h>

struct Data
{
    int a, b;
};

Span<struct Data> fun()
{
    int v[2] = {
        1,2
    };
    
    Span<struct Data> s = Span<struct Data>.map_from(v, sizeof(v), 1);
    
    return s;
}

int main(void)
{
    Span<struct Data> s = fun();
    
    printf("%d\n", s[0].a);
    return 0;
}
